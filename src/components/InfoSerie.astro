---
import {
  getElencoById,
  getEpisodiosById,
  getSerieById,
  type CastMember,
  type Episode,
  type Show,
} from '../services/shows';

interface Props {
  id?: string;
}

const { id } = Astro.props as Props;

let show: Show | null = null;
let elenco: CastMember[] = [];
let episodios: Episode[] = [];
let errorMessage = '';

try {
  if (!id) {
    throw new Error('Missing id');
  }

  [show, elenco, episodios] = await Promise.all([
    getSerieById(id),
    getElencoById(id),
    getEpisodiosById(id),
  ]);
} catch (error) {
  errorMessage = error instanceof Error ? error.message : 'Unknown error';
}

const titulo = show?.name ?? 'Sin titulo';
const imagen = show?.image?.medium ?? 'https://via.placeholder.com/210x295?text=Sin+Imagen';
const resumen = show?.summary ?? 'Sin resumen disponible.';
const lenguaje = show?.language ?? 'Desconocido';
const estado = show?.status ?? 'Desconocido';
const generos = show?.genres ?? [];
const rating = show?.rating?.average ?? 'N/A';

const anioInicio = show?.premiered ? show.premiered.slice(0, 4) : null;
const anioFin = show?.ended ? show.ended.slice(0, 4) : null;
const anios = anioInicio
  ? anioFin && anioFin !== anioInicio
    ? `${anioInicio}–${anioFin}`
    : anioInicio
  : null;

const temporadas = new Set(episodios.map((ep) => ep.season)).size;

const red = show?.network?.name
  ? `${show.network.name}${show.network.country?.code ? ` (${show.network.country.code})` : ''}`
  : 'Desconocida';

const tipo = show?.type ?? 'Desconocido';
const duracion = show?.averageRuntime ?? show?.runtime ?? null;
---

{
  errorMessage ? (
    <p>Error: {errorMessage}</p>
  ) : show ? (
    <>
      <section class="detalle-top">
        <div class="titulo-box">
          <h2>{titulo}</h2>
        </div>

        <div class="detalle-grid">
          <div class="imagen-box">
            <img src={imagen} alt={`Poster de ${titulo}`} />
          </div>

          <div class="info-box">
            <div class="resumen-box">
              <article set:html={resumen} />
            </div>

            <div class="datos-box">
              <div class="fila-datos">
                <span class="dato destacado">⭐ {rating}</span>
                <span class="dato">{estado}</span>
                <span class="dato">{lenguaje}</span>
                {anios && <span class="dato">{anios}</span>}
                {temporadas > 0 && (
                  <span class="dato">
                    {temporadas} temporada{temporadas !== 1 ? 's' : ''}
                  </span>
                )}
              </div>

              <div class="lista-generos">
                {generos.map((genero) => (
                  <span class="etiqueta-genero">{genero}</span>
                ))}
              </div>

              <div class="datos-extra">
                <div>
                  <span class="dato-label">RED</span>
                  <span class="dato-value">{red}</span>
                </div>

                <div>
                  <span class="dato-label">TIPO</span>
                  <span class="dato-value">{tipo}</span>
                </div>

                <div>
                  <span class="dato-label">DURACIÓN</span>
                  <span class="dato-value">{duracion ? `${duracion} min` : 'N/A'}</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      
      <section class="secciones-grid">
        <div class="panel episodios-panel">
          <div class="panel-header">
            <h3>Temporadas y episodios</h3>
            <span>{episodios.length} ep.</span>
          </div>

          <ul class="episodios">
            {episodios.map((episodio, index) => (
              <li>
                <span class="ep-num">
                  T{episodio.season} · E{String(episodio.number ?? 0).padStart(2, '0')}
                </span>
                <div class="ep-info">
                  <strong>{episodio.name}</strong>
                </div>
                <span class="ep-duracion">{episodio.runtime ?? 'N/A'} min</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="panel elenco-panel">
          <div class="panel-header">
            <h3>Elenco</h3>
            <span>{elenco.length}</span>
          </div>

          <ul class="elenco">
            {elenco.map((actor) => (
              <li>
                <div class="actor-info">
                  <strong>{actor.person.name}</strong>
                  <span>como {actor.character.name}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </>
  ) : (
    <p>No data</p>
  )
}

<style>
  .detalle-top{
    max-width: 1100px;
    margin: 0 auto 3rem auto;
    font-family: system-ui, sans-serif;
  }
  .titulo-box {
    padding: 0 0 1.2rem;
    margin-bottom: 1rem;
    text-align: left;
    background: transparent;
    border: none;
    margin-top: 1.5rem;
  }
  .titulo-box h2 {
    margin: 0;
    color: #e5e7eb;
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }  
  .detalle-grid {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .imagen-box {
    padding: 0;
    background: transparent;
    border: none;
  }

  .imagen-box img {
    width: 100%;
    max-width: 210px;
    border-radius: 16px;
    display: block;
    /*margin-top: 4px;*/
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  }

  .info-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-self: start;
  }

  .resumen-box,
  .datos-box {
    padding: 0;
    background: transparent;
    border: none;
  }

  .resumen-box {
    min-height: 140px;
  }

  .resumen-box article {
    color: #9ca3af;
    line-height: 1.8;
    font-size: 1rem;
    max-width: 850px;
  }

  .fila-datos {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .dato {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(15, 23, 42, 0.35);
    color: #e2e8f0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .dato.destacado {
    color: #facc15;
    border-color: rgba(250, 204, 21, 0.35);
  }

  .lista-generos {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .etiqueta-genero {
    background: rgba(255, 99, 99, 0.06);
    border: 1px solid rgba(255, 99, 99, 0.35);
    color: #ff7b7b;
    padding: 0.38rem 0.85rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .datos-extra {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .datos-extra > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .dato-label {
    font-size: 0.75rem;
    color: #7c8599;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dato-value {
    font-size: 0.98rem;
    color: #f8fafc;
    font-weight: 600;
  }
  .secciones-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 2rem;
  max-width: 1100px;
  margin: 2.5rem auto 0 auto;
  align-items: start;
}

.panel {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  overflow: hidden;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.panel-header h3 {
  margin: 0;
  color: #f8fafc;
  font-size: 1.1rem;
}

.panel-header span {
  color: #7c8599;
  font-size: 0.9rem;
}

ul.elenco,
ul.episodios {
  list-style: none;
  margin: 0;
  padding: 0;
}

ul.episodios li {
  display: grid;
  grid-template-columns: 60px 1fr 80px;
  gap: 1rem;
  align-items: center;
  padding: 0.9rem 1.25rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  color: #f8fafc;
}

ul.episodios li:last-child {
  border-bottom: none;
}

.ep-num {
  color: #7c8599;
  font-weight: 700;
  font-size: 0.9rem;
}

.ep-info strong {
  font-weight: 600;
}

.ep-duracion {
  color: #94a3b8;
  font-size: 0.9rem;
  text-align: right;
}

ul.elenco li {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

ul.elenco li:last-child {
  border-bottom: none;
}

.actor-info {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.actor-info strong {
  color: #f8fafc;
  font-weight: 600;
}

.actor-info span {
  color: #8b90a8;
  font-size: 0.95rem;
}

@media (max-width: 900px) {
  .secciones-grid {
    grid-template-columns: 1fr;
  }

  ul.episodios li {
    grid-template-columns: 50px 1fr;
  }

  .ep-duracion {
    grid-column: 2;
    text-align: left;
  }
}

</style>
