---
import LikeButton from "./LikeButton.jsx";
import type { Show } from "../services/shows";


const { show } = Astro.props as { show: Show };
const year = show.premiered ? show.premiered.slice(0, 4) : '—';

---

<article class="show-card">
  <div class="image-wrapper">
    {show.image?.medium && (
      <img src={show.image.medium} alt={show.name} />
    )}

    {show.rating?.average && (
    <span class="rating-badge">★ {show.rating.average}</span>
    )}
  </div>


  <div class="card-content">
    <div class="title-row">
      <h2>{show.name}</h2>
      <!--client: load carga el botón de "Me gusta" solo en el cliente, isla interactiva (hidratación)-->
      <LikeButton client:load showId={show.id} />
    </div>
  

    <div class="meta">
      <span>{year}</span>
      <span>{show.status ?? 'Desconocido'}</span>
    </div>

    <div class="genres">
      {show.genres.map((genre) => (
        <span>{genre}</span>
      ))}
    </div>

    <a href={`/shows/${show.id}`}>Ver detalle</a>
  </div>
</article>

<style>
  .show-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    color: #f8fafc;
    display: flex;
    flex-direction: column;
    height: 100%;
    backdrop-filter: blur(6px);
  }
  .image-wrapper {
    position: relative;
  }
  .show-card img {
    width: 100%;
    height: 290px;
    object-fit: cover;
    display: block;
  }
  .card-content{
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .title-row h2 {
    margin: 0;
    flex: 1;
  }

  .show-card h2 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.3;
  }
  .meta{
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .genres span {
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #cbd5e1;
    background: rgba(15, 23, 42, 0.35);
    padding: 0.22rem 0.6rem;
    border-radius: 8px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .rating-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #111827;
    color: #facc15;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.3rem 0.55rem;
    border-radius: 8px;
    border: 1px solid rgba(250, 204, 21, 0.35);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
  }
  .show-card a {
    margin-top: auto;
    text-decoration: none;
    font-weight: bold;
    color: #38bdf8;
  }
  .show-card a:hover {
    text-decoration: underline;
  }
</style>
