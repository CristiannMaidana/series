---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import ShowCard from '../components/ShowCard.astro';
import Pagination from '../components/Pagination.astro';
import { getSeries, type Show } from '../services/shows';

let shows: Show[] = [];
let errorMessage = '';

const url = new URL(Astro.request.url);
const currentPage = Number(url.searchParams.get('page')) || 1;
const itemsPerPage = 12;

try{
  shows = await getSeries();
  shows = shows.slice(0, 36);
} catch (error){
  errorMessage = error instanceof Error ? error.message : 'Error desconocido';
}

const start = (currentPage - 1) * itemsPerPage;
const end = start + itemsPerPage;
const paginatedShows = shows.slice(start, end);
const totalPages = Math.ceil(shows.length / itemsPerPage);
---


<Layout title="Inicio">
  <section class="hero">
    <p class="hero-kicker">EXPLORADOR DE SERIES</p>
    <h1>DESCUBRÍ TU PRÓXIMA SERIE</h1>
  </section>

  {
    errorMessage ? (
      <p>Error: {errorMessage}</p>
    ) : (
      <>
        <section class="shows-grid">
          {paginatedShows.map((show) => (
            <ShowCard show={show} />
          ))}
        </section>

        <Pagination currentPage={currentPage} totalPages={totalPages} />
      </>
    )
  }
</Layout>

<style>
	.shows-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .hero{
    padding: 1.2rem 0 0.8rem;
  }
  .hero-kicker {
    font-size: 0.68rem;
    color: #b84b63;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 4.8vw, 3.6rem);
    line-height: 0.95;
    margin: 0;
    color: #f8fafc;
    max-width: 560px;
    font-weight: 850;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
</style>
