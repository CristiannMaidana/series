---
import '../styles/global.css';

const {title = 'TVMaze Explorer'} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-content">
				<a href="/">TVMaze Explorer</a>

				<nav class="nav">
					<a href="/">Inicio</a>
				</nav>
			</div>
		</header>
		<main class="container">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
